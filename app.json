{
  "expo": {
    "name": "Sift",
    "slug": "siftcosts",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "sift",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.siftcosts.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "Sift needs camera access to scan your grocery receipts and supplier invoices.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Sift needs photo library access to import grocery receipts and supplier invoices.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#17624B"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F5F5F0"
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      [
        "@sentry/react-native",
        {
          "organization": "sift",
          "project": "react-native"
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": false
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "90a6fb52-c47f-4a1f-af47-f07488c2767a"
      }
    },
    "owner": "jvongampai",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "updates": {
      "url": "https://u.expo.dev/90a6fb52-c47f-4a1f-af47-f07488c2767a",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    }
  }
}
