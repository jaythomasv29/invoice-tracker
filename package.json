{
  "name": "sift",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@clerk/clerk-expo": "^2.19.31",
    "@expo-google-fonts/manrope": "^0.4.2",
    "@react-navigation/bottom-tabs": "^7.18.9",
    "@react-navigation/native": "^7.3.9",
    "@sentry/react-native": "~7.11.0",
    "@supabase/supabase-js": "^2.110.7",
    "babel-preset-expo": "~57.0.0",
    "decode-uri-component": "file:./vendor/decode-uri-component",
    "expo": "~57.0.31",
    "expo-auth-session": "~57.0.16",
    "expo-blur": "~57.0.3",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.0",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.1",
    "expo-font": "~57.0.0",
    "expo-haptics": "~57.0.3",
    "expo-image-manipulator": "~57.0.21",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.13",
    "expo-network": "~57.0.3",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.29",
    "expo-secure-store": "~57.0.4",
    "expo-sharing": "~57.0.24",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "expo-updates": "~57.0.26",
    "expo-web-browser": "~57.0.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-purchases": "^10.5.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-worklets": "0.10.1",
    "supabase": "^2.109.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check": "npm run typecheck && npm run lint && npm test",
    "build:phone": "eas build --platform ios --profile preview",
    "build:testflight": "eas env:exec production \"eas build --platform ios --profile testflight\" --non-interactive",
    "build:production": "eas env:exec production \"eas build --platform ios --profile production\" --non-interactive",
    "eas-build-post-install": "node scripts/check-release-config.mjs",
    "verify:release": "node scripts/check-release-config.mjs --production"
  },
  "private": true,
  "expo": {
    "install": {
      "exclude": [
        "react",
        "react-dom"
      ]
    }
  },
  "overrides": {
    "decode-uri-component": "$decode-uri-component"
  },
  "engines": {
    "node": ">=22.13 <23 || >=24.3"
  },
  "packageManager": "npm@10.9.2"
}
